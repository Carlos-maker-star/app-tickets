# Copiar a .env y completar. .env NO se commitea.
# Supabase > Project Settings > Database > Connection string > "Session pooler".
# Formato JDBC: sin usuario ni contrasena dentro de la URL.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=

# Base64 de al menos 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

CORS_ALLOWED_ORIGINS=http://localhost:4200

# Admin inicial: se crea al arrancar solo si no existe ningun ADMIN
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@tickets.local
ADMIN_PASSWORD=
